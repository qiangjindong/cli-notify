#!/usr/bin/env python3
import json
import os
from pathlib import Path
import shutil
import sys
import uuid
from session import run

ROOT=Path(__file__).resolve().parent

def main():
    install=json.loads((ROOT/'installation.json').read_text())
    codex=shutil.which('codex')
    if not codex: raise SystemExit('codex executable not found in PATH')
    run({'id':uuid.uuid4().hex,'cwd':os.getcwd(),'args':sys.argv[1:],
         'codex':codex,'helper':install['helper']})

if __name__=='__main__': main()
